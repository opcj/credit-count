# Browser-safe project configuration. Copy the values from your own Supabase project.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# LOCAL SETUP/TEST SCRIPTS ONLY. These are never imported by the app.
SUPABASE_SERVICE_ROLE_KEY=local-service-role-key
LOCAL_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
CREDIT_COUNT_LOCAL_TESTS=true
